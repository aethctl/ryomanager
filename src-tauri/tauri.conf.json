{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RyoManager",
  "version": "0.1.0",
  "identifier": "dev.ryoku.ryomanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RyoManager",
        "width": 1460,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "maxWidth": 1560,
        "maxHeight": 980,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
